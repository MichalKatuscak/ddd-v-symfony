@startuml projection_lifecycle
!include ../theme.iuml

title Projekce: tok z event streamu do read modelu

participant "Aggregate" as agg
database "Event Store" as es
queue "Event Bus\n(Messenger)" as bus
participant "Projector\n(OrderSummaryProjector)" as proj
database "Read Model\n(order_summary)" as rm
participant "Query Handler" as qh
actor "User" as user

== Write side: vznik eventu ==
agg -> es : append(OrderPlaced)
es -> bus : publish event\n(relay nad event_store)

== Projection: aktualizace read modelu ==
bus -> proj : OrderPlaced
group jedna DB transakce (idempotence guard)
  proj -> rm : INSERT IGNORE INTO projection_checkpoint\n(event_id, projection_name, processed_at)
  alt 1 affected row – nový event
    proj -> rm : INSERT INTO order_summary\n(order_id, customer_id, status, ...)
  else 0 affected rows – duplicitní doručení
    proj -> proj : skip\n(už zpracován)
  end
end

== Read side: dotaz uživatele ==
user -> qh : GET /orders
qh -> rm : SELECT * FROM order_summary\nWHERE customer_id = ?
rm --> qh : denormalizovaná data
qh --> user : view model

note over rm
  Read model je předpočítaná projekce.
  Dotazy jsou jednoduché SELECTy bez JOINů.
end note

@enduml
