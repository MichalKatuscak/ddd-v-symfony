@startuml snapshot_strategy
!include ../theme.iuml

title Snapshotting: zhuštěný stav místo plného replay

participant "Repository" as repo
database "Snapshot Store" as ss
database "Event Store" as es
participant "Aggregate" as agg

== Hydration s plným replay (pomalé) ==
note over repo, agg
  Long-lived agregát s 10 040 eventy:
  bez snapshotu se při každém načtení
  čte a přehrává celý stream.
end note

repo -> es : SELECT * FROM event_store\nWHERE aggregate_id = $id (10 040 řádků)
es --> repo : všechny eventy
loop 10 040×
  repo -> agg : apply(event)
end

== Hydration se snapshotem (rychlé) ==
repo -> ss : SELECT * FROM aggregate_snapshot\nWHERE aggregate_id = $id\nORDER BY version DESC LIMIT 1
ss --> repo : snapshot @ version 10 000
repo -> agg : reconstituteFromSnapshot(state, version)

repo -> es : SELECT * FROM event_store\nWHERE aggregate_id = $id\nAND version > 10 000
es --> repo : 40 eventů (od snapshotu)

loop 40×
  repo -> agg : apply(event)
end

repo --> agg : current state

== Snapshot při uložení ==
note over repo, ss
  save() překročí násobek N
  (v ukázce N = 50, laditelný parametr):
  zachycení stavu agregátu jako snapshot.
end note

repo -> agg : toSnapshot()
agg --> repo : state
repo -> ss : INSERT INTO aggregate_snapshot\n(aggregate_id, aggregate_type, version, state, taken_at)

@enduml
