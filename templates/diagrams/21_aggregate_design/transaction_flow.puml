@startuml transaction_flow
!include ../theme.iuml

title Tok transakce: jeden agregát na transakci + sága přes events

actor "Klient" as user
participant "Application\n(InitiateTransferHandler)" as app
database "DB" as db
queue "Outbox\n+ Messenger" as bus
participant "Sága\n(TransferSaga)" as saga

== Transakce 1: výběr ze zdrojového účtu (agregát A) ==
user -> app : InitiateTransfer(sourceId, targetId, amount)
app -> db : begin
app -> db : SELECT account WHERE id = sourceId\n(načte i version)
app -> db : UPDATE account SET balance = ..., version = version + 1\nWHERE id = ? AND version = ?\n(optimistický zámek)
app -> db : INSERT outbox(MoneyWithdrawn)
app -> db : commit
app --> user : 202 Accepted (transferId)

== Asynchronně: relay outboxu ==
db -> bus : MoneyWithdrawn

== Transakce 2: vklad na cílový účet (agregát B, oddělená) ==
bus -> saga : MoneyWithdrawn
saga -> db : begin
saga -> db : UPDATE account SET balance = ..., version = version + 1\nWHERE id = targetId AND version = ?\n(jiný agregát, jiná transakce)
saga -> db : commit

note over saga, db
  Když vklad selže, sága v další
  transakci vrátí peníze na zdrojový
  účet (kompenzace, refund).
end note

note over app, saga
  Žádná transakce nepřesahuje
  hranici agregátu. Ságy řeší
  konzistenci mezi agregáty.
end note

@enduml
