@startuml diagram
!include ../../theme.iuml

title E-shop: dva bounded contexty spojené doménovou událostí

package "Cart Bounded Context" as Cart {
  rectangle "**Cart**\n<size:12>agregátní kořen</size>" as CartAggregate {
  }
  note right of CartAggregate
    open(CartId, UserId): self
    addItem(ProductId, int, Money): void
    removeItem(ProductId): void
    checkout(): void
    totalAmount(): Money
  end note

  rectangle "CartItem\n<size:12>entita uvnitř agregátu</size>" as CartItem
  rectangle "CartRepository\n<size:12>rozhraní v doméně</size>" as CartRepo
  rectangle "AddItemToCartHandler" as AddHandler
  rectangle "CheckoutCartHandler" as CheckoutHandler
}

package "Order Bounded Context" as Order {
  rectangle "**Order**\n<size:12>agregátní kořen</size>" as OrderAggregate
  note right of OrderAggregate
    place(CustomerId, ShippingAddress, ...): self
    addItem(ProductId, int, Money): void
  end note

  rectangle "PlaceOrderOnCartCheckedOut\n<size:12>listener</size>" as Listener
  rectangle "OrderRepository" as OrderRepo
}

rectangle "**CartCheckedOut**\n<size:12>doménová událost</size>\n<size:11>cartId, userId, items[], totalAmount</size>" as Event #1B202A

CartAggregate "1" *-- "0..*" CartItem
AddHandler ..> CartRepo : získá a uloží
CheckoutHandler ..> CartRepo : získá a uloží
CartAggregate ..> Event : checkout() nahraje

Event --> Listener : Messenger
Listener ..> OrderAggregate : Order::place()
Listener ..> OrderRepo : uloží

note bottom of Event
  Kontexty spolu nemluví přímo.
  Listener překládá UserId na CustomerId –
  každý kontext má vlastní jméno pro zákazníka.
end note

@enduml
