@startuml choreography_vs_orchestration
!include ../theme.iuml

title Sága: choreografie vs. orchestrace

skinparam package {
  BackgroundColor $BG
  BorderColor $ACCENT
  FontColor $ACCENT
}

package "CHOREOGRAFIE: žádný centrální koordinátor" as choreo {
  rectangle "Ordering BC\n(emit OrderPlaced)" as c_order
  rectangle "Payment BC\n(charge, emit PaymentSucceeded)" as c_pay
  rectangle "Warehouse BC\n(reserve, emit StockReserved)" as c_inv
  rectangle "Shipping BC\n(create shipment, emit ShipmentCreated)" as c_ship

  c_order -[#F0A456]-> c_pay : OrderPlaced
  c_pay -[#F0A456]-> c_inv : PaymentSucceeded
  c_inv -[#F0A456]-> c_ship : StockReserved

  note bottom of c_ship #161A22
    + Loose coupling, autonomie BC
    – Nikdo neví, kde sága stojí
    – Cycle dependency riziko
    – Kompenzace skrytá
  end note
}

package "ORCHESTRACE: explicitní Process Manager" as orch {
  rectangle "OrderProcessManager\n(centrální koordinátor)" as o_pm

  rectangle "Ordering BC" as o_order
  rectangle "Payment BC" as o_pay
  rectangle "Warehouse BC" as o_inv
  rectangle "Shipping BC" as o_ship

  o_pm -[#F0A456]-> o_pay : 1. ChargeCustomer
  o_pm -[#F0A456]-> o_inv : 2. ReserveStock
  o_pm -[#F0A456]-> o_ship : 3. CreateShipment
  o_pm -[#F0A456]-> o_order : 4. ShipOrder

  note bottom of o_pm #161A22
    + Stav ságy explicitní (DB row)
    + Kompenzace v jedné třídě
    + Monitoring a recovery nad jedním místem
    – Koordinátor potřebuje vlastní
      perzistentní stav (tabulka order_saga)
  end note
}

@enduml
